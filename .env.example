# Django
# SECRET_KEY: chave secreta única do processo Django, usada para assinar
# sessões, tokens CSRF e afins. Gerar uma nova por ambiente (nunca reusar
# entre dev/prod ou entre sistemas gerados a partir deste template).
SECRET_KEY=replace-with-a-long-random-secret

# DEBUG: nunca True em produção — expõe stack trace e variáveis internas.
DEBUG=true

# DJANGO_SETTINGS_MODULE: seleciona qual módulo de config/settings/ é
# carregado (config.settings.dev ou config.settings.prod).
DJANGO_SETTINGS_MODULE=config.settings.dev

# ALLOWED_HOSTS: lista separada por vírgula dos hosts que o Django aceita
# no cabeçalho Host. Em produção, restringir ao(s) domínio(s) reais.
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF_TRUSTED_ORIGINS: origens (com esquema, http(s)://) autorizadas a
# fazer POST/PUT/DELETE com token CSRF válido — exigido desde Django 4.0.
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# SESSION_COOKIE_AGE: duração da sessão em segundos (28800s = 8h, jornada
# de trabalho padrão).
SESSION_COOKIE_AGE=28800

# AXES_COOLOFF_MINUTES: minutos de bloqueio após exceder o limite de
# tentativas de login (django-axes).
AXES_COOLOFF_MINUTES=15

# WEB_BIND_ADDRESS/WEB_PORT: endereço/porta onde o container "web" fica
# exposto no host. WEB_BIND_ADDRESS deve ficar em 127.0.0.1 — o app nunca
# fica exposto direto na rede, sempre atrás de um proxy do host.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000

# SECURE_SSL_REDIRECT/SECURE_HSTS_SECONDS: invariantes de segurança de
# produção — redireciona HTTP para HTTPS e fixa o HSTS (ver
# config/settings/prod.py para o SECURE_PROXY_SSL_HEADER associado).
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=3600

# PostgreSQL
# POSTGRES_DB/POSTGRES_USER/POSTGRES_PASSWORD: credenciais do container
# "db" (usadas pela própria imagem oficial do Postgres no primeiro boot).
POSTGRES_DB=sistema_base
POSTGRES_USER=sistema_base
POSTGRES_PASSWORD=replace-with-a-database-password

# DATABASE_URL: string de conexão consumida via django-environ (env.db).
# Deve refletir as mesmas credenciais definidas acima.
DATABASE_URL=postgres://sistema_base:replace-with-a-database-password@db:5432/sistema_base
