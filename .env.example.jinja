# Django
# SECRET_KEY: chave secreta única do processo Django, usada para assinar
# sessões, tokens CSRF e afins. Gere uma nova por ambiente e nunca a reutilize.
SECRET_KEY=replace-with-a-long-random-secret

# DEBUG: nunca True em produção — expõe stack trace e variáveis internas.
DEBUG=true

# DJANGO_SETTINGS_MODULE: seleciona qual módulo de config/settings/ é carregado.
DJANGO_SETTINGS_MODULE=config.settings.dev

# Hostname de produção respondido no Copier. Mantenha localhost para o uso local.
ALLOWED_HOSTS={{ sistema_hostname }},localhost,127.0.0.1
# Em produção, a origem confiável deve usar HTTPS e o hostname respondido.
CSRF_TRUSTED_ORIGINS=https://{{ sistema_hostname }}

# Duração de sessão e bloqueio após tentativas inválidas de login.
SESSION_COOKIE_AGE=28800
AXES_COOLOFF_MINUTES=15

# A publicação no host fica restrita ao loopback; Nginx faz o proxy externo.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT={{ sistema_porta }}

# Invariantes de segurança de produção.
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=3600

# Identidade do sistema, preenchida pelo Copier.
SISTEMA_NOME={{ sistema_nome }}
SISTEMA_SIGLA={{ sistema_sigla }}
COR_PRIMARIA={{ cor_primaria }}

# PostgreSQL: nome e usuário públicos vêm da resposta; senha continua local.
POSTGRES_DB={{ sistema_banco }}
POSTGRES_USER={{ sistema_banco }}
POSTGRES_PASSWORD=replace-with-a-database-password
DATABASE_URL=postgres://{{ sistema_banco }}:replace-with-a-database-password@db:5432/{{ sistema_banco }}

# Os dados do banco vivem num diretório do host (bind mount) — assim uma
# operação rotineira como `docker compose down -v` nunca destrói o banco.
# O default vive no compose (${PGDATA_DIR:-./dados/pg}); só defina aqui para
# trocar o local. O valor DEVE começar com `./` ou ser um caminho absoluto
# (sem o prefixo o Compose interpreta como nome de volume) e deve apontar
# sempre para um SUBDIRETÓRIO — nunca a raiz de um disco montado, pois o
# `lost+found` faz o initdb recusar o diretório.
# PGDATA_DIR=./dados/pg

# R2: credenciais nunca são respostas do Copier e devem ser preenchidas só no .env.
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_ENDPOINT=replace-with-r2-endpoint
R2_BUCKET=replace-with-r2-bucket-name

# Backup: a agenda e a retenção são validadas pelo container antes do crontab.
BACKUP_HORA=03
BACKUP_MINUTO=00
BACKUP_RETENCAO_DIARIA=7
BACKUP_RETENCAO_SEMANAL=4
# 1=segunda-feira .. 7=domingo.
BACKUP_DIA_SEMANAL=7
