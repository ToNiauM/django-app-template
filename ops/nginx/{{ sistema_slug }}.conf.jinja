# Nginx do host: a aplicação publicada pelo Compose permanece em loopback.
server {
    listen 443 ssl;
    server_name {{ sistema_hostname }};

    ssl_certificate     /etc/letsencrypt/live/{{ sistema_hostname }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ sistema_hostname }}/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:{{ sistema_porta }};
        proxy_http_version 1.1;

        # Os headers são definidos pela conexão que chegou ao Nginx, nunca pelo cliente.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}

server {
    listen 80;
    server_name {{ sistema_hostname }};
    return 301 https://$host$request_uri;
}
